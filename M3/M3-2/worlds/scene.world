<?xml version="1.0"?>
<sdf version="1.6">
  <world name="m3_2_loop_world">
    <physics name="default_physics" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry>
          <material>
            <ambient>0.62 0.62 0.62 1</ambient>
            <diffuse>0.62 0.62 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer rectangle: its inner faces are x=+/-7 and y=+/-5 m. -->
    <model name="outer_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north_collision"><pose>0 5.1 0.5 0 0 0</pose><geometry><box><size>14.4 0.2 1.0</size></box></geometry></collision>
        <visual name="north_visual"><pose>0 5.1 0.5 0 0 0</pose><geometry><box><size>14.4 0.2 1.0</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient></material></visual>
        <collision name="south_collision"><pose>0 -5.1 0.5 0 0 0</pose><geometry><box><size>14.4 0.2 1.0</size></box></geometry></collision>
        <visual name="south_visual"><pose>0 -5.1 0.5 0 0 0</pose><geometry><box><size>14.4 0.2 1.0</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient></material></visual>
        <collision name="west_collision"><pose>-7.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.0 1.0</size></box></geometry></collision>
        <visual name="west_visual"><pose>-7.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.0 1.0</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient></material></visual>
        <collision name="east_collision"><pose>7.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.0 1.0</size></box></geometry></collision>
        <visual name="east_visual"><pose>7.1 0 0.5 0 0 0</pose><geometry><box><size>0.2 10.0 1.0</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient></material></visual>
      </link>
    </model>

    <!-- A 10 x 6 m central island creates a 2 m wide rectangular loop. -->
    <model name="central_island">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="island">
        <collision name="collision"><geometry><box><size>10 6 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 6 1.0</size></box></geometry>
          <material><ambient>0.42 0.48 0.58 1</ambient><diffuse>0.42 0.48 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Self-designed challenge: baffles narrow the right corridor from 2.0
         to 1.2 m. They test whether a 5 cm grid preserves a navigable gate. -->
    <model name="narrow_gate">
      <static>true</static>
      <link name="baffles">
        <collision name="inner_collision"><pose>5.2 0 0.5 0 0 0</pose><geometry><box><size>0.4 0.5 1.0</size></box></geometry></collision>
        <visual name="inner_visual"><pose>5.2 0 0.5 0 0 0</pose><geometry><box><size>0.4 0.5 1.0</size></box></geometry><material><ambient>0.80 0.42 0.18 1</ambient></material></visual>
        <collision name="outer_collision"><pose>6.8 0 0.5 0 0 0</pose><geometry><box><size>0.4 0.5 1.0</size></box></geometry></collision>
        <visual name="outer_visual"><pose>6.8 0 0.5 0 0 0</pose><geometry><box><size>0.4 0.5 1.0</size></box></geometry><material><ambient>0.80 0.42 0.18 1</ambient></material></visual>
      </link>
    </model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <update_rate>20</update_rate>
      <ros><remapping>model_states:=/gazebo/model_states</remapping></ros>
    </plugin>

    <gui fullscreen="0">
      <camera name="overview">
        <pose>0 -15 18 0 0.72 1.57</pose>
      </camera>
    </gui>
  </world>
</sdf>
